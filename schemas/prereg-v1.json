{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ASSERT-KTH/assert-research-agent/blob/main/schemas/prereg-v1.json",
  "title": "Pre-registration",
  "description": "TOML front matter of a pre-registration (prereg/<yyyy-mm-dd>-<slug>.md): fixed before the data is seen, committed before any run. Specified in https://github.com/ASSERT-KTH/assert-research-agent/blob/main/CONVENTIONS.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "https://github.com/ASSERT-KTH/assert-research-agent/blob/main/schemas/prereg-v1.json",
      "description": "Mandatory: the URL of this schema, which leads back to the conventions."
    },
    "mode": {
      "const": "confirmatory"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "null": {
      "type": "string",
      "minLength": 1
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Every experiment this registration licenses (paths or directories)."
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The data range: every input path, none seen yet."
    },
    "statistic": {
      "type": "string",
      "minLength": 1
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "m": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of tests this registration makes."
    },
    "correction": {
      "enum": [
        "holm",
        "bonferroni",
        "hochberg",
        "benjamini-hochberg",
        "none"
      ]
    },
    "go": {
      "type": "string",
      "minLength": 1
    },
    "stop": {
      "type": "string",
      "minLength": 1
    },
    "disaster": {
      "type": "string",
      "minLength": 1
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "data_seen",
          "what",
          "why"
        ],
        "properties": {
          "date": {
            "type": "string",
            "minLength": 1
          },
          "data_seen": {
            "type": "boolean"
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "mode",
    "hypothesis",
    "null",
    "experiments",
    "data",
    "statistic",
    "alpha",
    "m",
    "correction",
    "go",
    "stop",
    "disaster"
  ],
  "if": {
    "properties": {
      "m": {
        "minimum": 2
      }
    },
    "required": [
      "m"
    ]
  },
  "then": {
    "properties": {
      "correction": {
        "not": {
          "const": "none"
        }
      }
    }
  }
}
