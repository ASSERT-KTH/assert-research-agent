{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/scripts/inject_discipline.py\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "^Bash$",
        "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/scripts/gate_run.py\"", "statusMessage": "Checking pre-registration" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/scripts/check_report.py\"" }] }
    ]
  }
}
